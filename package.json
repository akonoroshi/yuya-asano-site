{
  "name": "yuya-asano-site",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "node scripts/chat/build-context.mjs && node scripts/prepare-character-assets.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/chat/build-context.mjs && node scripts/chat/render-voice.mjs --check && node scripts/prepare-character-assets.mjs",
    "build": "astro build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "upgrade:astro": "npx @astrojs/upgrade",
    "upgrade:check": "npm outdated",
    "sync:publications": "node scripts/sync-publications.mjs",
    "chat:context": "node scripts/chat/build-context.mjs",
    "chat:paraphrase": "node scripts/chat/paraphrase.mjs",
    "chat:index": "node scripts/chat/index-content.mjs",
    "chat:eval": "node scripts/chat/eval-router.mjs",
    "chat:voice": "node scripts/chat/render-voice.mjs",
    "test:chat": "node --test \"tests/chat/*.test.ts\"",
    "cf-typegen": "wrangler types",
    "clean": "rm -rf dist .astro node_modules/.vite public/chat public/characters",
    "dev:fresh": "npm run clean && npm run dev"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.0.0",
    "@tonari/characters": "github:akonoroshi/vrm-characters#9d63634f1ee0643d79e38ba5ead7048c61842729",
    "astro": "^7.4.5",
    "cmu-pronouncing-dictionary": "^3.0.0",
    "kuromoji": "^0.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "wrangler": "^4.0.0"
  }
}

---
// The chat over the full-screen character: one caption for the current reply, a row of
// suggested-question chips that changes with the conversation, a slim input bar, and the full
// conversation in a transcript drawer. Talks to the 3D character only through window events, so either can load
// or fail without the other:
//   chat:reply-start / chat:reply-end           a reply begins / ends (with its plain and tagged text)
//   chat:tag   { kind: "act" | "emo", name, strength?, at }   a behavior tag the text just reached
//   character:loaded                            (dispatched by the character) start loading voice dictionaries
// Shino's own voice (voice.ts) listens to the same events; the Voice button in the top bar
// (ChatStage.astro) turns it on and off.
// Voice has two modes, chosen the first time the visitor taps the microphone and switchable
// from the note under the input: tap to ask (asr.ts) and conversation (conversation.ts).
import type { Lang } from "../i18n/ui";
import { chatStrings } from "../data/chat/strings";
// The voice's credit line, required by the VOICEVOX speaker's terms wherever her voice is used.
import voices from "../../tts-server/voices.json";

interface Props {
  lang: Lang;
  /** Wait for a "chat:init" event before loading anything (used by the corner launcher). */
  lazy?: boolean;
  /** Which page the chat is on, for page-specific starting chips (faq.ts pageChips). */
  page?: string;
}
const { lang, lazy = false, page = "home" } = Astro.props;

const strings = chatStrings[lang];
const intro = page.startsWith("project:") ? strings.introProject : strings.intro;
const voiceCredit = lang === "ja" ? voices.ja.credit : "";
---

<section class="chat" data-chat data-lang={lang} data-chat-lazy={lazy ? "" : undefined} data-chat-page={page} data-chat-intro={intro} aria-label={strings.region}>
  <p class="chat-asked" data-asked hidden><span class="chat-sr">{strings.youAsked} </span><span data-asked-text></span></p>
  <!-- About four lines tall so the reply never covers much of the character. Replies stream in
       and the caption follows the newest text; tabindex lets keyboard users scroll back. -->
  <div class="chat-caption" data-caption aria-live="polite" tabindex="0">
    <div class="msg-text">{intro}</div>
  </div>
  <div class="chat-chips" data-chips role="group" aria-label={strings.suggested}></div>
  <!-- Shown the first time the visitor taps the microphone; switchable later from the note. -->
  <div class="chat-voice-choice" data-voice-choice hidden role="group" aria-labelledby={`chat-voice-title-${lang}`}>
    <p class="chat-voice-title" id={`chat-voice-title-${lang}`}>{strings.voiceChoiceTitle}</p>
    <div class="chat-voice-options">
      <button type="button" class="chat-voice-option" data-voice-mode="conversation">
        <span class="chat-voice-name">{strings.modeConversation}</span>
        <span class="chat-voice-desc">{strings.modeConversationDesc}</span>
      </button>
      <button type="button" class="chat-voice-option" data-voice-mode="tap">
        <span class="chat-voice-name">{strings.modeTap}</span>
        <span class="chat-voice-desc">{strings.modeTapDesc}</span>
      </button>
    </div>
    <button type="button" class="chat-voice-dismiss" data-voice-dismiss>{strings.notNow}</button>
  </div>
  <form class="chat-input" data-form>
    <label class="chat-sr" for={`chat-q-${lang}`}>{strings.label}</label>
    <textarea id={`chat-q-${lang}`} rows="1" maxlength="500" placeholder={strings.placeholder} data-input></textarea>
    <button type="button" class="chat-icon" data-mic hidden aria-pressed="false" aria-label={strings.micStart} title={strings.micStart}>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
        <rect x="9" y="3" width="6" height="11" rx="3"></rect>
        <path d="M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21"></path>
      </svg>
    </button>
    <button type="submit" class="chat-icon chat-send" data-send aria-label={strings.send} title={strings.send}>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 19V5M6 11l6-6 6 6"></path>
      </svg>
    </button>
  </form>
  <div class="chat-note">
    <span>{strings.disclosure}</span>
    {voiceCredit && <span>{strings.voiceCredit.replace("{credit}", voiceCredit)}</span>}
    <span data-status role="status" hidden></span>
    <button type="button" class="chat-mode-switch" data-voice-switch hidden></button>
  </div>
  <aside class="chat-transcript" id={`chat-transcript-${lang}`} data-transcript hidden aria-label={strings.transcript}>
    <div class="chat-transcript-head">
      <span>{strings.transcript}</span>
      <button type="button" class="chat-icon" data-transcript-close aria-label={strings.closeTranscript} title={strings.closeTranscript}>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      </button>
    </div>
    <ol class="chat-log" data-log>
      <li class="msg msg--agent"><div class="msg-text">{intro}</div></li>
    </ol>
  </aside>
  <script type="application/json" data-strings set:html={JSON.stringify(strings)} />
</section>

<script>
  import { canRecognizeLocally, Listener, speechSupported, type ListenError } from "../lib/chat/asr.ts";
  import { ConversationListener } from "../lib/chat/conversation.ts";
  import { ChatController, type ChatStrings, type Chip, type ReplyView } from "../lib/chat/controller.ts";
  import { parseConfirm, prependToAlternatives } from "../lib/chat/turn.ts";
  import { VoicePlayer } from "../lib/chat/voice.ts";
  import type { Lang, Link } from "../lib/chat/types.ts";

  type Strings = ChatStrings & {
    sources: string;
    micStart: string;
    micStop: string;
    micConversation: string;
    switchToTap: string;
    switchToConversation: string;
    listeningNote: string;
    conversationFallback: string;
    idleStopped: string;
    voiceLocal: string;
    voiceCloud: string;
    loadFailed: string;
    listen: Record<ListenError, string>;
  };

  // The home page starts the chat right away. The chat behind the corner launcher waits until
  // it is opened, so other pages don't download the FAQ data or dictionaries until then.
  for (const root of document.querySelectorAll<HTMLElement>("[data-chat]")) {
    if (root.hasAttribute("data-chat-lazy")) root.addEventListener("chat:init", () => setup(root), { once: true });
    else setup(root);
  }

  function setup(root: HTMLElement) {
    const lang = root.dataset.lang as Lang;
    const s = JSON.parse(root.querySelector("[data-strings]")!.textContent!) as Strings;
    const $ = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
    const asked = $<HTMLElement>("[data-asked]");
    const askedText = $<HTMLElement>("[data-asked-text]");
    const caption = $<HTMLElement>("[data-caption]");
    const chips = $<HTMLElement>("[data-chips]");
    const form = $<HTMLFormElement>("[data-form]");
    const input = $<HTMLTextAreaElement>("[data-input]");
    const send = $<HTMLButtonElement>("[data-send]");
    const mic = $<HTMLButtonElement>("[data-mic]");
    const status = $<HTMLElement>("[data-status]");
    const transcript = $<HTMLElement>("[data-transcript]");
    // The toggle lives in the top bar of ChatStage.astro, outside this component.
    const openBtn = (root.closest("[data-chat-stage]") ?? document).querySelector<HTMLButtonElement>("[data-chat-transcript-toggle]");
    const log = $<HTMLOListElement>("[data-log]");
    const choice = $<HTMLElement>("[data-voice-choice]");
    const modeSwitch = $<HTMLButtonElement>("[data-voice-switch]");
    let currentChips: Chip[] = []; // so "Did you mean …?" can be answered out loud
    let lastAsked = ""; // the "You asked" line, restored after live speech is shown there
    let afterIdle: (() => void) | null = null; // runs when the controller stops being busy

    const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls: string, text?: string) => {
      const e = document.createElement(tag);
      e.className = cls;
      if (text) e.textContent = text;
      return e;
    };
    const anchor = (l: Link) => {
      const a = el("a", "inline", l.label);
      a.href = l.href;
      // Same rule as Base.astro: other sites and PDFs open in a new tab.
      if (!l.href.startsWith("/") || l.href.endsWith(".pdf")) {
        a.target = "_blank";
        a.rel = "noopener noreferrer";
      }
      return a;
    };
    /** Plain text with [label](url) links; everything else stays text, never HTML. */
    const renderText = (target: HTMLElement, text: string) => {
      target.replaceChildren();
      const re = /\[([^\]]+)\]\(((?:https?:\/\/|\/)[^)\s]+)\)/g;
      let at = 0;
      for (const m of text.matchAll(re)) {
        target.append(text.slice(at, m.index), anchor({ label: m[1], href: m[2] }));
        at = m.index! + m[0].length;
      }
      target.append(text.slice(at));
    };
    const extras = (target: HTMLElement, extra?: { links?: Link[]; sources?: Link[] }) => {
      if (extra?.links?.length) {
        const row = el("p", "msg-links");
        row.append(...extra.links.map(anchor));
        target.append(row);
      }
      if (extra?.sources?.length) {
        const row = el("p", "msg-sources", `${s.sources}: `);
        extra.sources.forEach((l, i) => row.append(...(i ? [", ", anchor(l)] : [anchor(l)])));
        target.append(row);
      }
    };
    const scrollLog = () => log.scrollTo({ top: log.scrollHeight });
    // While a reply streams in, the caption follows the newest text, like subtitles. If the
    // visitor scrolls up to reread, it stops following until they scroll back to the bottom.
    // A fade at the bottom edge shows there is more text below.
    let follow = true;
    const fromBottom = () => caption.scrollHeight - caption.clientHeight - caption.scrollTop;
    const updateCaption = () => caption.classList.toggle("has-more", fromBottom() > 2);
    caption.addEventListener(
      "scroll",
      () => {
        follow = fromBottom() <= 4;
        updateCaption();
      },
      { passive: true },
    );
    const followCaption = () => {
      if (follow) caption.scrollTop = caption.scrollHeight;
      updateCaption();
    };
    new ResizeObserver(updateCaption).observe(caption);

    /* ---------- Transcript drawer ---------- */
    const setTranscript = (open: boolean) => {
      transcript.hidden = !open;
      openBtn?.setAttribute("aria-expanded", String(open));
      if (open) {
        scrollLog();
        $<HTMLButtonElement>("[data-transcript-close]").focus();
      } else openBtn?.focus();
    };
    openBtn?.addEventListener("click", () => setTranscript(transcript.hasAttribute("hidden")));
    // Esc closes the transcript first; only a second Esc closes the full-screen chat dialog.
    const isOpen = () => !transcript.hasAttribute("hidden");
    const choosing = () => !choice.hasAttribute("hidden");
    // Replaced in setupVoice; until then the choice can't be open.
    let closeChoice = (_focusMic = true) => {};
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && (isOpen() || choosing())) {
        e.preventDefault();
        e.stopPropagation();
        if (isOpen()) setTranscript(false);
        else closeChoice();
      }
    }, { capture: true });
    root.closest("dialog")?.addEventListener("cancel", (e) => {
      if (isOpen() || choosing()) e.preventDefault();
    });
    root.closest("dialog")?.addEventListener("close", () => {
      transcript.hidden = true;
      openBtn?.setAttribute("aria-expanded", "false");
    });
    $<HTMLButtonElement>("[data-transcript-close]").addEventListener("click", () => setTranscript(false));

    const controller = new ChatController(
      lang,
      {
        showQuestion(text) {
          lastAsked = text;
          asked.classList.remove("is-live");
          askedText.textContent = text;
          asked.hidden = false;
          const li = el("li", "msg msg--user");
          li.append(el("div", "msg-text", text));
          log.append(li);
          scrollLog();
        },
        startReply(): ReplyView {
          // The caption shows only the current reply; the transcript keeps every reply.
          const capText = el("div", "msg-text");
          caption.replaceChildren(capText);
          caption.scrollTop = 0;
          follow = true;
          caption.classList.add("is-pending");
          const li = el("li", "msg msg--agent");
          const logText = el("div", "msg-text");
          li.append(logText);
          log.append(li);
          let raw = "";
          return {
            hint(t) {
              capText.textContent = t;
              capText.classList.add("is-hint");
            },
            append(t) {
              caption.classList.remove("is-pending");
              capText.classList.remove("is-hint");
              raw += t;
              capText.textContent = logText.textContent = raw.trimStart();
              followCaption();
              scrollLog();
            },
            finish(extra) {
              caption.classList.remove("is-pending");
              renderText(capText, raw.trim());
              renderText(logText, raw.trim());
              extras(caption, extra);
              extras(li, extra);
              followCaption();
              scrollLog();
            },
            fail(message) {
              caption.classList.remove("is-pending");
              capText.classList.remove("is-hint");
              if (!raw.trim()) capText.textContent = "";
              if (raw.trim()) {
                renderText(capText, raw.trim());
                renderText(logText, raw.trim());
              }
              caption.append(el("p", "msg-error", message));
              li.append(el("p", "msg-error", message));
              followCaption();
            },
          };
        },
        setChips(list) {
          currentChips = list;
          chips.replaceChildren(
            ...list.map((c) => {
              const b = el("button", c.kind === "confirm" ? "chat-chip chat-chip--confirm" : "chat-chip", c.label);
              b.type = "button";
              b.addEventListener("click", () => {
                if (!controller.isBusy()) c.onPick();
              });
              return b;
            }),
          );
        },
        setBusy(busy) {
          send.disabled = busy;
          chips.toggleAttribute("aria-disabled", busy);
          root.toggleAttribute("aria-busy", busy);
          // After the controller finishes its own bookkeeping (chips, saving) in this tick.
          if (!busy && afterIdle) setTimeout(() => !controller.isBusy() && afterIdle?.(), 0);
        },
        retract() {
          // The last question and everything after it (its unanswered reply) leave the transcript.
          const users = log.querySelectorAll<HTMLElement>(".msg--user");
          const last = users[users.length - 1];
          for (let n: Element | null = last ?? null; n; ) {
            const next: Element | null = n.nextElementSibling;
            n.remove();
            n = next;
          }
          lastAsked = users.length > 1 ? (users[users.length - 2].textContent ?? "") : "";
          // Shino goes back to waiting while the visitor finishes.
          caption.replaceChildren(el("div", "msg-text"));
          caption.classList.add("is-pending");
        },
      },
      s,
      root.dataset.chatPage,
    );

    /* ---------- Shino's voice (voice.ts): off until the Voice button or a voice conversation ---------- */
    const stage = root.closest("[data-chat-stage]") ?? document;
    const player = new VoicePlayer(lang);
    const voiceBtn = stage.querySelector<HTMLButtonElement>("[data-chat-voice-toggle]");
    const syncVoiceBtn = () => voiceBtn?.setAttribute("aria-pressed", String(player.enabled));
    if (voiceBtn) {
      voiceBtn.hidden = false;
      syncVoiceBtn();
      voiceBtn.addEventListener("click", () => {
        player.setEnabled(!player.enabled);
        // Turned on before anything was said on this page: she greets out loud.
        if (player.enabled && caption.textContent?.trim() === root.dataset.chatIntro) player.sayOnce(root.dataset.chatIntro!);
      });
    }
    window.addEventListener("character:voice-state", syncVoiceBtn);
    // Mobile browsers only play audio after a gesture: any tap or key in the chat counts.
    for (const type of ["pointerdown", "keydown"]) stage.addEventListener(type, () => player.unlock(), { capture: true });

    /* ---------- Text input ---------- */
    let voice: { top: string; alternatives: string[] } | null = null;
    const grow = () => {
      input.style.height = "auto";
      input.style.height = `${input.scrollHeight}px`;
    };
    input.addEventListener("input", grow);
    input.addEventListener("keydown", (e) => {
      if (e.key === "Enter" && !e.shiftKey && !e.isComposing) {
        e.preventDefault();
        form.requestSubmit();
      }
    });
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const text = input.value.trim();
      if (!text || controller.isBusy()) return;
      // Spoken and unedited: pass the recognizer's alternatives on. Edited: treat as typed.
      const opts = voice && voice.top === text ? { source: "voice" as const, alternatives: voice.alternatives } : { source: "typed" as const };
      voice = null;
      input.value = "";
      grow();
      controller.ask(text, opts);
    });

    /* ---------- Load the FAQ (this also shows the first chips), then voice ---------- */
    controller.load().then(
      (ctx) => {
        if (speechSupported()) setupVoice(ctx.phrases);
      },
      () => {
        status.textContent = s.loadFailed;
        status.hidden = false;
      },
    );

    function setupVoice(phrases: string[]) {
      mic.hidden = false;
      let transcribeNote = "";
      const setStatus = (text: string) => {
        status.textContent = text;
        status.hidden = !text;
      };
      canRecognizeLocally(lang).then((local) => {
        transcribeNote = local ? s.voiceLocal : s.voiceCloud;
        if (status.hidden) setStatus(transcribeNote);
      });
      // Load the pronunciation dictionary once the character is in, or after a few seconds.
      const warm = () => controller.warmPhonemes();
      window.addEventListener("character:loaded", warm, { once: true });
      setTimeout(warm, 6000);

      /* ----- Mode: asked on the first tap, kept for the tab like the conversation ----- */
      type Mode = "conversation" | "tap";
      const MODE_KEY = "chat:voice-mode";
      let mode: Mode | null = null;
      try {
        const saved = sessionStorage.getItem(MODE_KEY);
        if (saved === "conversation" || saved === "tap") mode = saved;
      } catch {
        /* storage disabled: ask again on each page */
      }
      let tap: Listener | null = null;
      let tapCancelled = false;
      let conv: ConversationListener | null = null;

      const updateMic = () => {
        const live = !!tap || !!conv?.isActive;
        const label = live ? s.micStop : mode === "conversation" ? s.micConversation : s.micStart;
        mic.setAttribute("aria-pressed", String(live));
        mic.setAttribute("aria-label", label);
        mic.title = label;
        root.classList.toggle("is-listening", live);
        modeSwitch.hidden = !mode;
        modeSwitch.textContent = mode === "conversation" ? s.switchToTap : s.switchToConversation;
      };
      const setMode = (m: Mode) => {
        mode = m;
        try {
          sessionStorage.setItem(MODE_KEY, m);
        } catch {
          /* fine: it just won't carry over */
        }
        updateMic();
      };
      updateMic();

      const openChoice = () => {
        choice.hidden = false;
        root.classList.add("is-choosing");
        choice.querySelector<HTMLButtonElement>("[data-voice-mode]")?.focus();
      };
      closeChoice = (focusMic = true) => {
        choice.hidden = true;
        root.classList.remove("is-choosing");
        if (focusMic) mic.focus();
      };
      for (const b of choice.querySelectorAll<HTMLButtonElement>("[data-voice-mode]")) {
        b.addEventListener("click", () => {
          closeChoice(false);
          setMode(b.dataset.voiceMode as Mode);
          mic.focus();
          startVoice();
        });
      }
      $<HTMLButtonElement>("[data-voice-dismiss]").addEventListener("click", () => closeChoice());

      const stopAll = (reason: "user" | "hidden") => {
        if (tap) {
          tapCancelled = true;
          tap.abort();
        }
        conv?.stop(reason);
      };
      mic.addEventListener("click", () => {
        if (tap) return tap.stop(); // tap to ask: stop early and keep what was heard
        if (conv?.isActive) return conv.stop("user");
        if (choosing()) return closeChoice();
        if (!mode) return openChoice();
        startVoice();
      });
      modeSwitch.addEventListener("click", () => {
        const next: Mode = mode === "conversation" ? "tap" : "conversation";
        stopAll("user");
        setMode(next);
        // Choosing conversation is a request to talk now; tap to ask waits for the mic.
        if (next === "conversation") startConversation();
      });
      const startVoice = () => (mode === "conversation" ? startConversation() : startTap());

      // Never leave the microphone on behind the visitor's back.
      document.addEventListener("visibilitychange", () => {
        if (document.hidden) stopAll("hidden");
      });
      window.addEventListener("pagehide", () => stopAll("hidden"));
      root.closest("dialog")?.addEventListener("close", () => stopAll("user"));

      /* ----- Tap to ask: one question, shown in the input to check before sending ----- */
      async function startTap() {
        warm();
        input.value = "";
        grow();
        tapCancelled = false;
        tap = new Listener(lang, phrases, (interim) => {
          input.value = interim;
          grow();
        });
        updateMic();
        try {
          const { alternatives } = await tap.start();
          input.value = alternatives[0];
          voice = { top: alternatives[0], alternatives };
          grow();
          input.focus();
        } catch (e) {
          if (!tapCancelled) {
            const code = (typeof e === "string" && e in s.listen ? e : "unavailable") as ListenError;
            setStatus(s.listen[code]);
          }
          input.value = "";
          grow();
        } finally {
          tap = null;
          updateMic();
        }
      }

      /* ----- Conversation: always on, sent when the visitor finishes speaking ----- */
      let prefix: string | null = null; // a question taken back because the visitor kept going
      let queued: string[] | null = null; // a turn finished while Shino was still answering
      // True while Shino's voice is on: then she "speaks" only while audio plays.
      let voicePlayer = player.enabled;
      window.addEventListener("character:voice-state", (e) => {
        voicePlayer = !!(e as CustomEvent<{ enabled: boolean }>).detail?.enabled;
        conv?.setSpeaking(!voicePlayer && controller.isBusy());
      });

      // Live words go in the "You asked" line, so the input stays free for typing.
      const showLive = (text: string) => {
        if (text) {
          askedText.textContent = text;
          asked.classList.add("is-live");
          asked.hidden = false;
        } else {
          asked.classList.remove("is-live");
          askedText.textContent = lastAsked;
          asked.hidden = !lastAsked;
        }
      };
      const submitVoice = (alternatives: string[]) => {
        if (!alternatives.length) return;
        if (controller.isBusy()) {
          queued = alternatives; // the latest turn wins: "wait, what about…" replaces the earlier one
          return;
        }
        controller.ask(alternatives[0], { source: "voice", alternatives, handsFree: true });
      };
      afterIdle = () => {
        if (!queued) return;
        const q = queued;
        queued = null;
        submitVoice(q);
      };
      const flushPrefix = () => {
        if (!prefix) return;
        const p = prefix;
        prefix = null;
        submitVoice([p]);
      };

      // With voice off, Shino "speaks" while her reply is being written out. With voice on, the
      // voice player's character:speech-start/-end take over (voice.ts).
      window.addEventListener("chat:reply-start", () => !voicePlayer && conv?.setSpeaking(true));
      window.addEventListener("chat:reply-end", () => !voicePlayer && conv?.setSpeaking(false));
      window.addEventListener("character:speech-start", () => {
        voicePlayer = true;
        conv?.setSpeaking(true);
      });
      window.addEventListener("character:speech-end", () => conv?.setSpeaking(false));

      async function startConversation() {
        warm();
        // A spoken conversation gets spoken answers (unless voice was turned off in this tab).
        // Here, still inside the click that started it, so the browser allows the audio.
        player.autoEnable();
        const listener = new ConversationListener(lang, phrases, {
          onInterim: showLive,
          onUserTalking() {
            // The visitor kept talking after a turn was sent: take it back if it isn't answered yet.
            const q = controller.retractPending();
            if (q) prefix = q;
          },
          onTurn(alternatives) {
            // "Did you mean …?" answered out loud: "yes", "no", "something else".
            const confirm = currentChips.filter((c) => c.role);
            if (!prefix && confirm.length && !controller.isBusy()) {
              for (const a of alternatives) {
                const chip = confirm.find((c) => c.role === parseConfirm(a, lang));
                if (chip) return chip.onPick();
              }
            }
            const merged = prefix ? prependToAlternatives(prefix, alternatives, lang) : alternatives;
            prefix = null;
            submitVoice(merged);
          },
          onTurnDropped: flushPrefix,
          onStop(reason) {
            if (conv === listener) conv = null;
            showLive("");
            flushPrefix();
            updateMic();
            if (reason === "failed" || reason === "unsupported") {
              setMode("tap");
              setStatus(s.conversationFallback);
            } else if (reason === "not-allowed") setStatus(s.listen["not-allowed"]);
            else if (reason === "idle") setStatus(s.idleStopped);
            else setStatus(transcribeNote);
          },
        });
        conv = listener;
        try {
          await listener.start();
          if (listener.isActive) {
            listener.setSpeaking(!voicePlayer && controller.isBusy());
            setStatus(s.listeningNote);
          }
        } catch (e) {
          if (conv === listener) conv = null;
          if (e === "not-allowed") setStatus(s.listen["not-allowed"]);
          else {
            setMode("tap");
            setStatus(s.conversationFallback);
          }
        }
        updateMic();
      }
    }
  }
</script>


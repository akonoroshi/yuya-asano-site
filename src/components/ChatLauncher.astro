---
// The small character in the bottom-right corner of every page except the home page.
// Clicking it opens the same full-screen chat as the home page, in a modal dialog, and the
// conversation continues from wherever the visitor left it (saved per tab in sessionStorage).
// Nothing chat-related is downloaded until the first click.
//
// Any element with data-chat-open on the page (like the "Talk to my AI companion" link on the
// portfolio page) opens the dialog too, instead of following its link.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import ChatStage from "./ChatStage.astro";
import type { Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";

interface Props {
  lang: Lang;
  /** Page key for page-specific starting chips; see faq.ts pageChips. */
  chatPage?: string;
}
const { lang, chatPage = "work" } = Astro.props;
const t = useTranslations(lang);
const hint = chatPage.startsWith("project:") ? t("chatLauncherHintProject") : t("chatLauncherHint");

// A still of the character for the button: put a square image at
// src/assets/character-launcher.png (or .jpg / .webp). Until then, a simple drawn face is shown.
const stills = import.meta.glob<{ default: ImageMetadata }>("../assets/character-launcher.{png,jpg,jpeg,webp,avif}", { eager: true });
const still = Object.values(stills)[0]?.default;
---

<button type="button" class="chat-launcher" data-chat-launcher aria-haspopup="dialog" aria-label={t("openChat")}>
  <span class="chat-launcher-hint" aria-hidden="true">{hint}</span>
  <span class="chat-launcher-face">
    {still ? (
      <Image src={still} alt="" width={112} height={112} loading="lazy" />
    ) : (
      <svg viewBox="0 0 56 56" aria-hidden="true">
        <circle cx="28" cy="28" r="27" style="fill: var(--agent-soft)"></circle>
        <circle cx="21" cy="25" r="3" style="fill: var(--agent)"></circle>
        <circle cx="35" cy="25" r="3" style="fill: var(--agent)"></circle>
        <path d="M20 34c4 4.5 12 4.5 16 0" fill="none" stroke-width="2.4" stroke-linecap="round" style="stroke: var(--agent)"></path>
      </svg>
    )}
  </span>
</button>

<dialog class="chat-dialog" data-chat-dialog aria-label={t("openChat")}>
  <ChatStage lang={lang} mode="overlay" chatPage={chatPage} />
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("dialog[data-chat-dialog]");
  const launcher = document.querySelector<HTMLButtonElement>("[data-chat-launcher]");
  if (dialog && launcher) {
    const chat = dialog.querySelector<HTMLElement>("[data-chat]");
    const slot = dialog.querySelector<HTMLElement>("[data-character-slot]");
    let started = false;

    const open = () => {
      if (dialog.open) return;
      if (!started && chat) {
        chat.dispatchEvent(new Event("chat:init")); // Chat.astro starts loading only now
        started = true;
      }
      dialog.showModal();
      document.documentElement.classList.add("chat-open");
      window.dispatchEvent(new CustomEvent("chat:open", { detail: { slot } }));
    };

    launcher.addEventListener("click", open);
    dialog.querySelector("[data-chat-close]")?.addEventListener("click", () => dialog.close());
    dialog.addEventListener("close", () => {
      document.documentElement.classList.remove("chat-open");
      window.dispatchEvent(new CustomEvent("chat:close"));
      launcher.focus();
    });

    // Links on the page marked data-chat-open open the dialog instead of navigating.
    // (Without JavaScript they still go to the home page, where the chat is.)
    document.addEventListener("click", (e) => {
      const trigger = (e.target as Element | null)?.closest?.("[data-chat-open]");
      if (!trigger) return;
      e.preventDefault();
      open();
    });
  }
</script>

<style is:global>
  .chat-launcher {
    position: fixed;
    z-index: 40;
    right: max(16px, env(safe-area-inset-right));
    bottom: max(16px, env(safe-area-inset-bottom));
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .chat-launcher-face {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--surface);
    box-shadow: 0 2px 10px rgb(24 25 27 / 0.12);
    transition: transform 200ms var(--ease-out), box-shadow 200ms var(--ease-out);
  }
  .chat-launcher-face img,
  .chat-launcher-face svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .chat-launcher:hover .chat-launcher-face {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgb(24 25 27 / 0.16);
  }
  .chat-launcher:active .chat-launcher-face {
    transform: scale(0.96);
  }
  .chat-launcher:focus-visible {
    outline: none;
  }
  .chat-launcher:focus-visible .chat-launcher-face {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }
  /* The hint shows only where there is room beside the page's 640px column. */
  .chat-launcher-hint {
    display: none;
    padding: 6px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink);
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
  }
  @media (min-width: 1080px) {
    .chat-launcher-hint {
      display: inline-block;
    }
  }

  /* The dialog is the full screen: same experience as the home page. */
  .chat-dialog {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--paper);
    color: var(--ink);
  }
  .chat-dialog::backdrop {
    background: var(--paper);
  }
  .chat-dialog[open] {
    animation: chat-dialog-in 280ms var(--ease-out) both;
    transform-origin: calc(100% - 44px) calc(100% - 44px); /* grows out of the corner character */
  }
  @keyframes chat-dialog-in {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
  }
  html.chat-open {
    overflow: hidden; /* the page behind doesn't scroll while the chat is open */
  }
  @media print {
    .chat-launcher {
      display: none;
    }
  }
</style>

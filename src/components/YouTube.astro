---
interface Props { id: string; title: string; poster?: string; lang?: 'en' | 'ja' }
const { id, title, lang = 'en' } = Astro.props;
const poster = Astro.props.poster ?? `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
const params = new URLSearchParams({ autoplay: '1', rel: '0', hl: lang, cc_lang_pref: lang });
const src = `https://www.youtube-nocookie.com/embed/${id}?${params}`;
---
<div class="yt" data-src={src} data-title={title}>
  <button type="button" aria-label={lang === 'ja' ? `再生: ${title}` : `Play: ${title}`}>
    <img src={poster} alt="" width="1280" height="720" loading="lazy" />
    <span class="play" aria-hidden="true">▶</span>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.yt').forEach((el) => {
    el.querySelector('button')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = el.dataset.src!;
      iframe.title = el.dataset.title!;
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      el.replaceChildren(iframe);
    }, { once: true });
  });
</script>

<style>
  .yt { position: relative; aspect-ratio: 16 / 9; border-radius: 8px; overflow: hidden; background: #000; }
  .yt button { display: block; width: 100%; height: 100%; padding: 0; border: 0; background: none; cursor: pointer; }
  .yt button:focus-visible { outline: 3px solid #4c8bf5; outline-offset: -3px; }
  .yt img, .yt :global(iframe) { display: block; width: 100%; height: 100%; object-fit: cover; border: 0; }
  .play { position: absolute; inset: 0; margin: auto; width: 68px; height: 48px; display: grid; place-items: center;
          background: rgba(0,0,0,.7); color: #fff; border-radius: 12px; font-size: 22px; }
</style>
---
// One 404 page serves both languages, so it shows both.
import Base from "../layouts/Base.astro";
---

<Base title="Page not found | ページが見つかりません" description="This page doesn’t exist." lang="en">
  <main class="wrap">
    <h1 class="statement">This page doesn’t exist.</h1>
    <p class="lede">It may have moved. You can find all of my projects on the <a class="inline" href="/">main page</a>.</p>
    <div lang="ja">
      <h2 class="statement" style="margin-top:48px">ページが見つかりません。</h2>
      <p class="lede">移動した可能性があります。すべてのプロジェクトは<a class="inline" href="/ja/">トップページ</a>からご覧いただけます。</p>
    </div>
  </main>
</Base>

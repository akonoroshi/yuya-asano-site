# Copy to .env on the VM (never commit .env).
# The same value as the Worker secret TTS_SERVER_TOKEN. Generate with: openssl rand -hex 32
TTS_SERVER_TOKEN=
# From Cloudflare: Zero Trust > Networks > Tunnels > your tunnel > install connector.
TUNNEL_TOKEN=
# Optional: a commit hash of huggingface.co/hexgrad/Kokoro-82M.
KOKORO_REVISION=main
